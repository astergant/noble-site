{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "noble-site",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist/web/browser",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/api/*"],
  },
}
