# Copy to .env and fill in. Never commit .env.

PORT=3000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200,https://nobledetailing.ge
# Number of reverse proxies in front of the API (Nginx/Cloudflare = 1). Needed for correct rate limiting by IP.
TRUST_PROXY=1

# Rate limit for POST /api/lead: requests per window per IP.
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_MIN=15

# Telegram notifications to the admins chat (create a bot via @BotFather, add it to the chat).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail duplicate (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Noble Detailing <no-reply@nobledetailing.com>"
MAIL_TO=

# Optional Cloudflare Turnstile. Leave empty to disable.
TURNSTILE_SECRET=

# Google Sheet (Лист1). Prefer a service account; webhook is the Apps Script fallback.
# Share the spreadsheet with GOOGLE_CLIENT_EMAIL as Editor. Never commit the private key.
GOOGLE_SHEET_ID=1uPXgis_qGkNgSZ0yWt5On_thZRUkHAXg0CUK7VbpyrY
GOOGLE_SHEET_TAB=Лист1
# Prefer copying the downloaded JSON to api/google-sa.json (gitignored).
# GOOGLE_CLIENT_EMAIL / GOOGLE_PRIVATE_KEY are only a fallback and often break on Windows.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
